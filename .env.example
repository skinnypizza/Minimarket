# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================

# Host del servidor PostgreSQL (usualmente 'localhost' para desarrollo local)
DB_HOST=localhost

# Usuario de PostgreSQL (crear un usuario específico para la aplicación)
DB_USER=tu_usuario_postgres

# Contraseña del usuario de PostgreSQL
# IMPORTANTE: Usar una contraseña segura y única
DB_PASSWORD=tu_contraseña_segura

# Nombre de la base de datos
DB_NAME=minimarket

# Puerto de PostgreSQL (por defecto: 5432)
DB_PORT=5432

# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================

# Secreto para JWT y sesiones
# CRÍTICO: Generar un secreto aleatorio único de al menos 64 caracteres
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=59c0e4d200702c407b68b0f80ea2fd5663cfc31663cd6be6d103e49f6eb4c936

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto en el que se ejecutará el servidor (por defecto: 3000)
PORT=3000
