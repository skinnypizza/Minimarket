<!DOCTYPE html>
<html lang="es">

<head>
    <title>Inventario - MAXMARKET</title>
    <%- include('partials/head_tailwind') %>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="/js/product-management.js"></script>
</head>

<body class="bg-gray-50">

    <div class="min-h-screen flex flex-col md:flex-row">

        <!-- Sidebar (Desktop) / Bottom Nav (Mobile) -->
        <aside class="hidden md:flex flex-col w-64 bg-white border-r border-gray-200 fixed h-full z-30">
            <div class="p-6 border-b border-gray-100 flex items-center gap-3">
                <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center text-white">
                    <i class="fas fa-boxes"></i>
                </div>
                <span class="font-bold text-xl text-gray-800">Inventario</span>
            </div>

            <nav class="flex-1 p-4 space-y-2">
                <a href="#overview"
                    class="sidebar-link active flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-brand-50 hover:text-brand-600 transition-colors"
                    data-target="overview">
                    <i class="fas fa-chart-pie w-5"></i> Resumen
                </a>
                <a href="#create"
                    class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-brand-50 hover:text-brand-600 transition-colors"
                    data-target="create">
                    <i class="fas fa-plus-circle w-5"></i> Crear
                </a>
                <a href="#products"
                    class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-brand-50 hover:text-brand-600 transition-colors"
                    data-target="products">
                    <i class="fas fa-box w-5"></i> Productos
                </a>
            </nav>

            <div class="p-4 border-t border-gray-100">
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-500">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold text-gray-900 truncate">
                            <%= user.name %>
                        </p>
                        <p class="text-xs text-gray-500 truncate">
                            <%= user.email %>
                        </p>
                    </div>
                </div>
                <a href="/auth/logout"
                    class="flex items-center gap-2 text-red-500 text-sm font-medium px-4 mt-2 hover:text-red-600">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 md:ml-64 p-4 md:p-8 pb-24 md:pb-8">

            <!-- Mobile Header -->
            <div class="md:hidden flex justify-between items-center mb-6">
                <h1 class="text-2xl font-bold text-gray-900">Inventario</h1>
                <div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center">
                    <i class="fas fa-user"></i>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (locals.messages && messages.length> 0) { %>
                <div class="mb-6 space-y-2">
                    <% messages.forEach(function(message) { %>
                        <div
                            class="p-4 rounded-xl border <%= message.type === 'error' ? 'bg-red-50 border-red-100 text-red-600' : 'bg-green-50 border-green-100 text-green-600' %>">
                            <%= message.text %>
                        </div>
                        <% }); %>
                </div>
                <% } %>

                    <!-- Sections -->
                    <div id="overview" class="admin-section-content space-y-6">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4">Resumen de Inventario</h2>
                        <%- include('partials/kpi_dashboard') %>
                    </div>

                    <div id="create" class="admin-section-content hidden space-y-6">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4">Agregar Nuevo Producto</h2>
                        <div class="max-w-lg mx-auto">
                            <%- include('partials/create_product_section') %>
                        </div>
                    </div>

                    <div id="products" class="admin-section-content hidden space-y-6">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4">Gestión de Existencias</h2>
                        <%- include('partials/product_management_section') %>
                    </div>

        </main>

        <!-- Mobile Bottom Nav -->
        <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 z-40 pb-safe">
            <div class="grid grid-cols-4 h-16">
                <button onclick="switchSection('overview')"
                    class="nav-item active flex flex-col items-center justify-center text-gray-400 hover:text-brand-600"
                    data-target="overview">
                    <i class="fas fa-chart-pie text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Resumen</span>
                </button>
                <button onclick="switchSection('create')"
                    class="nav-item flex flex-col items-center justify-center text-gray-400 hover:text-brand-600"
                    data-target="create">
                    <i class="fas fa-plus-circle text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Crear</span>
                </button>
                <button onclick="switchSection('products')"
                    class="nav-item flex flex-col items-center justify-center text-gray-400 hover:text-brand-600"
                    data-target="products">
                    <i class="fas fa-box text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Productos</span>
                </button>
                <a href="/auth/logout"
                    class="flex flex-col items-center justify-center text-gray-400 hover:text-red-500">
                    <i class="fas fa-sign-out-alt text-xl mb-1"></i>
                    <span class="text-[10px] font-medium">Salir</span>
                </a>
            </div>
        </nav>

    </div>

    <script>
        // Tab Switching Logic
        const sections = document.querySelectorAll('.admin-section-content');
        const sidebarLinks = document.querySelectorAll('.sidebar-link');
        const mobileNavItems = document.querySelectorAll('.nav-item');

        function switchSection(targetId) {
            // Hide all sections
            sections.forEach(s => s.classList.add('hidden'));
            // Show target
            document.getElementById(targetId).classList.remove('hidden');

            // Update Active States
            sidebarLinks.forEach(l => {
                l.classList.toggle('active', l.dataset.target === targetId);
                l.classList.toggle('bg-brand-50', l.dataset.target === targetId);
                l.classList.toggle('text-brand-600', l.dataset.target === targetId);
            });

            mobileNavItems.forEach(l => {
                l.classList.toggle('text-brand-600', l.dataset.target === targetId);
            });
        }

        // Event Listeners
        sidebarLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                switchSection(link.dataset.target);
            });
        });
    </script>
    <script src="/js/kpi-charts.js"></script>

    <style>
        .sidebar-link.active {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .nav-item.active {
            color: #16a34a;
        }
    </style>
</body>

</html>