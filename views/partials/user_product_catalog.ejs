<!-- User Product Catalog Component -->
<div class="bg-white rounded-lg sm:rounded-xl shadow-md p-2 sm:p-4" style="border-top: 4px solid #52b788;">
    <!-- Search and Filter Bar -->
    <div class="mb-3 sm:mb-4">
        <div class="flex flex-col gap-2 sm:gap-3">
            <!-- Search -->
            <div class="relative">
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="Buscar productos..." 
                    class="w-full px-3 py-2 pl-9 rounded-lg focus:ring-2 focus:outline-none text-sm"
                    style="border: 1px solid #d4d8d4; background-color: #fafbf8;"
                    onfocus="this.style.borderColor='#52b788'; this.style.boxShadow='0 0 0 3px rgba(82, 183, 136, 0.1)'"
                    onblur="this.style.borderColor='#d4d8d4'; this.style.boxShadow='none'"
                >
                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-sm" style="color: #636e72;"></i>
            </div>
            
            <!-- Category Filter -->
            <div class="flex gap-1.5 sm:gap-2 overflow-x-auto pb-2 hide-scrollbar">
                <button onclick="filterByCategory('all')" id="cat-all" class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded-full whitespace-nowrap transition" style="background-color: #52b788; color: white;">
                    Todos
                </button>
                <% 
                const categories = [...new Set(products.map(p => p.category || 'General'))].sort();
                categories.forEach(cat => { 
                %>
                    <button onclick="filterByCategory('<%= cat %>')" id="cat-<%= cat %>" class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded-full whitespace-nowrap transition" style="background-color: #e8f5f0; color: #52b788;">
                        <%= cat %>
                    </button>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Products Grid - 3 columns on mobile, responsive -->
    <div id="productsContainer" class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-2 sm:gap-3">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="product-card flex flex-col bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden" 
                     style="border: 1px solid #e8e8e8;"
                     data-product-id="<%= product.id %>"
                     data-product-name="<%= product.name %>"
                     data-product-price="<%= product.price %>"
                     data-product-stock="<%= product.totalStock || 0 %>"
                     data-product-category="<%= product.category || 'General' %>">
                    
                    <!-- Product Image -->
                    <div class="relative w-full bg-gray-100" style="padding-bottom: 100%;">
                        <div class="absolute inset-0">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" 
                                     alt="<%= product.name %>" 
                                     class="w-full h-full object-cover"
                                     onerror="this.src='/img/no-image.png'">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center" style="color: #636e72;">
                                    <i class="fas fa-box text-2xl sm:text-3xl"></i>
                                </div>
                            <% } %>
                            
                            <!-- Stock Badge -->
                            <div class="absolute top-1 right-1">
                                <% const stock = product.totalStock || 0; %>
                                <% if (stock > 20) { %>
                                    <span class="px-1.5 py-0.5 text-white text-xs font-bold rounded" style="background-color: #52b788;">
                                        ✓
                                    </span>
                                <% } else if (stock > 0) { %>
                                    <span class="px-1.5 py-0.5 text-white text-xs font-bold rounded" style="background-color: #fdcb6e;">
                                        <%= stock %>
                                    </span>
                                <% } else { %>
                                    <span class="px-1.5 py-0.5 text-white text-xs font-bold rounded" style="background-color: #d63031;">
                                        ✗
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Product Info -->
                    <div class="p-2 flex flex-col flex-1">
                        <h3 class="font-bold mb-1 line-clamp-2 text-xs" style="color: #2d3436; min-height: 2.5em;"><%= product.name %></h3>
                        
                        <div class="font-bold mb-2 text-sm" style="color: #52b788;">
                            Bs <%= product.price.toFixed(2) %>
                        </div>

                        <!-- Add to Cart Button -->
                        <% if (stock > 0) { %>
                            <button onclick="addToCart('<%= product.id %>', '<%= product.name %>', <%= product.price %>, <%= stock %>)" 
                                    class="w-full text-white font-bold py-1.5 rounded transition-all duration-200 active:scale-95 text-xs mt-auto"
                                    style="background-color: #52b788;"
                                    ontouchstart="this.style.backgroundColor='#40916c'"
                                    ontouchend="this.style.backgroundColor='#52b788'"
                                    onmouseover="this.style.backgroundColor='#40916c'"
                                    onmouseout="this.style.backgroundColor='#52b788'">
                                <i class="fas fa-plus text-xs"></i> Agregar
                            </button>
                        <% } else { %>
                            <button disabled 
                                    class="w-full font-bold py-1.5 rounded cursor-not-allowed text-xs mt-auto"
                                    style="background-color: #d4d8d4; color: #636e72;">
                                Agotado
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="grid-column: 1 / -1;" class="text-center py-8 sm:py-12">
                <i class="fas fa-box-open text-4xl sm:text-6xl mb-3 sm:mb-4" style="color: #d4d8d4;"></i>
                <p style="color: #636e72;" class="text-sm sm:text-lg">No hay productos disponibles.</p>
            </div>
        <% } %>
    </div>
</div>

<style>
.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Hide scrollbar but keep functionality */
.hide-scrollbar::-webkit-scrollbar {
    display: none;
}
.hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* Product card - PREVENT ANY OVERLAP */
.product-card {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    position: relative;
}

.product-card img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Grid container fix */
#productsContainer {
    width: 100%;
    box-sizing: border-box;
}

#productsContainer > * {
    min-width: 0;
    box-sizing: border-box;
}
</style>
