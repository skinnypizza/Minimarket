<style>
    /* Mobile-First Footer Styles */
    footer {
        width: 100%;
    }
    
    .location-map {
        height: 250px;
        width: 100%;
    }
    
    .location-map iframe {
        width: 100%;
        height: 100%;
    }
    
    .footer-container {
        padding: 1.5rem 1rem;
    }
    
    .footer-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .footer-section h3 {
        font-size: 1rem;
        margin-bottom: 1rem;
    }
    
    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .contact-item {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        font-size: 0.875rem;
    }
    
    .contact-item i {
        font-size: 1rem;
        margin-top: 0.25rem;
        flex-shrink: 0;
    }
    
    .contact-item div {
        flex: 1;
    }
    
    .contact-item strong {
        display: block;
        margin-bottom: 0.25rem;
    }
    
    .phone-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        margin-top: 1rem;
        font-size: 0.875rem;
        border-radius: 8px;
        transition: all 0.3s;
    }
    
    .social-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    
    .social-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.125rem;
        transition: all 0.3s;
    }
    
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .contact-form input,
    .contact-form textarea {
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.875rem;
        width: 100%;
    }
    
    .contact-form textarea {
        min-height: 80px;
        resize: vertical;
    }
    
    .contact-form button {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .footer-bottom {
        margin-top: 2rem;
        padding-top: 1.5rem;
        text-align: center;
        font-size: 0.75rem;
    }
    
    /* Tablet */
    @media (min-width: 640px) {
        .location-map {
            height: 300px;
        }
        
        .footer-content {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .contact-item {
            font-size: 0.9375rem;
        }
        
        .footer-section h3 {
            font-size: 1.125rem;
        }
    }
    
    /* Desktop */
    @media (min-width: 1024px) {
        .location-map {
            height: 350px;
        }
        
        .footer-container {
            padding: 2.5rem 2rem;
        }
        
        .footer-content {
            grid-template-columns: repeat(4, 1fr);
            gap: 2.5rem;
        }
        
        .contact-item {
            font-size: 1rem;
        }
        
        .footer-section h3 {
            font-size: 1.25rem;
        }
        
        .phone-btn {
            font-size: 1rem;
        }
        
        .social-icon {
            width: 45px;
            height: 45px;
            font-size: 1.25rem;
        }
        
        .contact-form input,
        .contact-form textarea {
            font-size: 1rem;
        }
        
        .contact-form button {
            font-size: 1rem;
        }
        
        .footer-bottom {
            font-size: 0.875rem;
        }
    }
</style>

