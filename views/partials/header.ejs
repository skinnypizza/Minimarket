<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <title>MAXMARKET - Minimarket</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/auth.js"></script>
    <style>
        /* Mobile-First Header Styles */
        header nav {
            padding: 0.75rem 1rem;
            flex-wrap: nowrap;
        }
        
        header .logo a {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        header .logo-img {
            height: 32px;
            width: auto;
        }
        
        header .logo span {
            font-size: 1rem;
            font-weight: 700;
        }
        
        /* Mobile Menu Toggle */
        .mobile-menu-toggle {
            display: none;
            background: none;
            border: none;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 1001;
            order: -1;
        }
        
        @media (max-width: 768px) {
            header nav {
                position: relative;
                display: flex;
                align-items: center;
            }
            
            .mobile-menu-toggle {
                display: block;
            }
            
            header .logo {
                flex: 1;
            }
            
            header nav ul {
                position: fixed;
                top: 0;
                right: -100%;
                width: 70%;
                max-width: 300px;
                height: 100vh;
                background: linear-gradient(135deg, #52b788 0%, #40916c 100%);
                flex-direction: column;
                padding: 5rem 1.5rem 2rem 1.5rem;
                margin: 0;
                gap: 0.5rem;
                transition: right 0.3s ease;
                box-shadow: -2px 0 10px rgba(0,0,0,0.3);
                z-index: 1000;
            }
            
            header nav ul.mobile-menu-open {
                right: 0;
            }
            
            header nav ul li {
                width: 100%;
                margin: 0;
            }
            
            header nav ul li a {
                display: block;
                width: 100%;
                padding: 0.75rem 1rem;
                border-radius: 8px;
                transition: all 0.2s;
            }
            
            header nav ul li a:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateX(5px);
            }
            
            /* Mobile menu overlay */
            .mobile-menu-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background: rgba(0, 0, 0, 0.5);
                z-index: 999;
            }
            
            .mobile-menu-overlay.active {
                display: block;
            }
        }
        
        @media (min-width: 769px) {
            header .logo-img {
                height: 40px;
            }
            
            header .logo span {
                font-size: 1.25rem;
            }
        }
    </style>
</head>
<body>
    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay" onclick="toggleMobileMenu()"></div>
    
    <header>
        <nav>
            <button class="mobile-menu-toggle" id="mobileMenuToggle" onclick="toggleMobileMenu()" aria-label="Menú">
                <i class="fas fa-bars" id="menuIcon"></i>
            </button>
            
            <div class="logo">
                <a href="/">
                    <img src="/img/logo.png" alt="Logo MAXMARKET" class="logo-img">
                    <span>MAXMARKET</span>
                </a>
            </div>
            
            <ul id="mobileMenu">
                <li><a href="/" onclick="closeMobileMenu()">Inicio</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/dashboard" onclick="closeMobileMenu()">Administrar</a></li>
                    <% } else { %>
                        <li><a href="/dashboard" onclick="closeMobileMenu()">Dashboard</a></li>
                    <% } %>
                    <li><a href="/auth/logout" onclick="closeMobileMenu()">Salir</a></li>
                <% } else { %>
                    <li><a href="/auth/login" onclick="closeMobileMenu()">Iniciar Sesión</a></li>
                    <li><a href="/auth/register" onclick="closeMobileMenu()">Registrarse</a></li>
                <% } %>
            </ul>
        </nav>
    </header>
    
    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileMenuOverlay');
            const icon = document.getElementById('menuIcon');
            
            menu.classList.toggle('mobile-menu-open');
            overlay.classList.toggle('active');
            
            if (menu.classList.contains('mobile-menu-open')) {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
                document.body.style.overflow = 'hidden';
            } else {
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
                document.body.style.overflow = '';
            }
        }
        
        function closeMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileMenuOverlay');
            const icon = document.getElementById('menuIcon');
            
            menu.classList.remove('mobile-menu-open');
            overlay.classList.remove('active');
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
            document.body.style.overflow = '';
        }
    </script>
