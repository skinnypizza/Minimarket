<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 w-full">
    <form action="/products" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
            <label for="name" class="block text-sm font-bold text-gray-700 mb-2">Nombre del Producto</label>
            <input id="name" name="name" required
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all placeholder-gray-400"
                placeholder="Ej: Coca Cola 2L" />
        </div>
        <div>
            <label for="description" class="block text-sm font-bold text-gray-700 mb-2">Descripción</label>
            <textarea id="description" name="description" rows="3"
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all resize-none placeholder-gray-400"
                placeholder="Descripción del producto (opcional)"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="price" class="block text-sm font-bold text-gray-700 mb-2">Precio (Bs.)</label>
                <input id="price" name="price" type="number" step="0.01" value="0" required
                    class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all" />
            </div>
            <div>
                <label for="stock" class="block text-sm font-bold text-gray-700 mb-2">Stock Inicial</label>
                <input id="stock" name="stock" type="number" value="0" required
                    class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all" />
            </div>
        </div>
        <div>
            <label for="category" class="block text-sm font-bold text-gray-700 mb-2">Categoría</label>
            <select id="category" name="category" required
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all text-gray-700">
                <option value="" disabled selected>Selecciona una categoría</option>
                <option value="Lácteos">Lácteos</option>
                <option value="Panadería">Panadería</option>
                <option value="Despensa">Despensa</option>
                <option value="Bebidas">Bebidas</option>
                <option value="Snacks">Snacks</option>
                <option value="Limpieza">Limpieza</option>
                <option value="Enlatados">Enlatados</option>
                <option value="Congelados">Congelados</option>
                <option value="General">General</option>
            </select>
        </div>
        <div>
            <label for="image" class="block text-sm font-bold text-gray-700 mb-2">Imagen del Producto</label>
            <input id="image" name="image" type="file" accept="image/*"
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-brand-100 file:text-brand-700 file:font-bold hover:file:bg-brand-200 file:cursor-pointer text-gray-500" />
            <small class="text-gray-500 text-xs mt-1 block">Formatos: JPG, PNG, GIF. Máximo 5MB</small>
        </div>
        <button type="submit"
            class="w-full py-3.5 bg-brand-600 text-white rounded-xl font-bold shadow-lg shadow-brand-200 hover:bg-brand-700 transform hover:-translate-y-0.5 transition-all">
            <i class="fas fa-plus-circle mr-2"></i> Crear Producto
        </button>
    </form>
</div>