<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
    <form action="/auth/admin/register" method="POST" class="space-y-4">
        <div>
            <label for="name" class="block text-sm font-bold text-gray-700 mb-2">Nombre Completo</label>
            <input id="name" name="name" type="text" required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-500 focus:ring-0 outline-none transition-colors"
                placeholder="Ej: Juan Pérez" />
        </div>
        <div>
            <label for="email" class="block text-sm font-bold text-gray-700 mb-2">Email</label>
            <input id="email" name="email" type="email" required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-500 focus:ring-0 outline-none transition-colors"
                placeholder="ejemplo@correo.com" />
        </div>
        <div>
            <label for="password" class="block text-sm font-bold text-gray-700 mb-2">Contraseña</label>
            <input id="password" name="password" type="password" required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-500 focus:ring-0 outline-none transition-colors"
                placeholder="Mínimo 8 caracteres" />
            <small class="text-gray-500 text-xs mt-1 block">Debe contener mayúsculas, minúsculas, números y caracteres
                especiales</small>
        </div>
        <div>
            <label for="role" class="block text-sm font-bold text-gray-700 mb-2">Rol del Usuario</label>
            <select id="role" name="role" required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-brand-500 focus:ring-0 outline-none transition-colors">
                <option value="user">Cliente (User)</option>
                <option value="cajero">Cajero</option>
                <option value="inventario">Inventario</option>
                <option value="admin">Administrador</option>
            </select>
        </div>
        <button type="submit"
            class="w-full py-3.5 bg-brand-600 text-white rounded-xl font-bold shadow-lg shadow-brand-200 hover:bg-brand-700 transform hover:-translate-y-0.5 transition-all">
            <i class="fas fa-user-plus mr-2"></i> Crear Usuario
        </button>
    </form>
</div>