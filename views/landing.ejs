<!DOCTYPE html>
<html lang="es">

<head>
    <title>MAXMARKET - Tu Supermercado Online</title>
    <%- include('partials/head_tailwind') %>
</head>

<body class="bg-gray-50">

    <!-- Navbar -->
    <nav class="fixed w-full z-50 glass border-b border-gray-200/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center text-white">
                        <i class="fas fa-shopping-basket"></i>
                    </div>
                    <span class="font-bold text-xl tracking-tight text-gray-900">MAXMARKET</span>
                </div>
                <div class="hidden md:flex items-center space-x-8">
                    <a href="#features"
                        class="text-gray-600 hover:text-brand-600 font-medium transition-colors">Beneficios</a>
                    <a href="#catalog"
                        class="text-gray-600 hover:text-brand-600 font-medium transition-colors">Catálogo</a>
                    <% if (typeof user !=='undefined' && user) { %>
                        <a href="/dashboard"
                            class="bg-brand-600 text-white px-5 py-2 rounded-full font-medium hover:bg-brand-700 transition-all shadow-lg shadow-brand-200">Ir
                            al Dashboard</a>
                        <% } else { %>
                            <a href="/auth/login" class="text-brand-600 font-medium hover:text-brand-700">Iniciar
                                Sesión</a>
                            <a href="/auth/register"
                                class="bg-brand-600 text-white px-5 py-2 rounded-full font-medium hover:bg-brand-700 transition-all shadow-lg shadow-brand-200">Registrarse</a>
                            <% } %>
                </div>
                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center">
                    <a href="/auth/login" class="text-gray-600 hover:text-brand-600 p-2">
                        <i class="fas fa-user-circle text-2xl"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="relative pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-3xl mx-auto">
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                    Tu mercado favorito,<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400">ahora en tu
                        bolsillo</span>
                </h1>
                <p class="text-lg md:text-xl text-gray-600 mb-8 leading-relaxed">
                    Miles de productos frescos, precios increíbles y entrega rápida. La experiencia de compra que
                    mereces.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <% if (typeof user !=='undefined' && user) { %>
                        <a href="/dashboard"
                            class="bg-brand-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-brand-700 transition-all shadow-xl shadow-brand-200 transform hover:-translate-y-1">
                            Comenzar a Comprar
                        </a>
                        <% } else { %>
                            <a href="/auth/register"
                                class="bg-brand-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-brand-700 transition-all shadow-xl shadow-brand-200 transform hover:-translate-y-1">
                                Crear Cuenta Gratis
                            </a>
                            <a href="#catalog"
                                class="bg-white text-gray-700 border border-gray-200 px-8 py-4 rounded-full font-bold text-lg hover:bg-gray-50 transition-all">
                                Ver Catálogo
                            </a>
                            <% } %>
                </div>
            </div>
        </div>

        <!-- Decorative blobs -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 opacity-30 pointer-events-none">
            <div
                class="absolute top-0 left-1/4 w-96 h-96 bg-brand-300 rounded-full mix-blend-multiply filter blur-3xl animate-blob">
            </div>
            <div
                class="absolute top-0 right-1/4 w-96 h-96 bg-green-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000">
            </div>
            <div
                class="absolute -bottom-32 left-1/3 w-96 h-96 bg-emerald-300 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-4000">
            </div>
        </div>
    </div>

    <!-- Features -->
    <section id="features" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-3 gap-8">
                <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:shadow-lg transition-all">
                    <div
                        class="w-12 h-12 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-4">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Envíos Flash</h3>
                    <p class="text-gray-600">Recibe tus productos en tiempo récord. Priorizamos tu tiempo.</p>
                </div>
                <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:shadow-lg transition-all">
                    <div
                        class="w-12 h-12 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-4">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Calidad Segura</h3>
                    <p class="text-gray-600">Seleccionamos cuidadosamente cada producto. Garantía de frescura.</p>
                </div>
                <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:shadow-lg transition-all">
                    <div
                        class="w-12 h-12 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center text-2xl mb-4">
                        <i class="fas fa-tag"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Precios Justos</h3>
                    <p class="text-gray-600">Ofertas diarias y precios competitivos para cuidar tu economía.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Public Product Catalog (HU-08) -->
    <section id="catalog" class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Catálogo de Productos</h2>
                <p class="text-gray-600">Consulta precios y disponibilidad en tiempo real</p>
            </div>

            <!-- Search and Filter Bar -->
            <div class="flex flex-col md:flex-row gap-4 mb-8">
                <div class="flex-1 relative">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="catalogSearch" placeholder="Buscar productos..."
                        class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all">
                </div>
                <select id="categoryFilter"
                    class="px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-white min-w-[180px]">
                    <option value="">Todas las categorías</option>
                </select>
                <button onclick="loadPublicProducts()"
                    class="bg-brand-600 text-white px-6 py-3 rounded-xl font-medium hover:bg-brand-700 transition-all flex items-center gap-2">
                    <i class="fas fa-sync-alt"></i> Actualizar
                </button>
            </div>

            <!-- Stock Legend -->
            <div class="flex flex-wrap gap-4 mb-6 text-sm">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-green-500"></span>
                    <span class="text-gray-600">Disponible</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-orange-500"></span>
                    <span class="text-gray-600">Últimas unidades</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-500"></span>
                    <span class="text-gray-600">Agotado</span>
                </div>
            </div>

            <!-- Loading State -->
            <div id="catalogLoading" class="hidden text-center py-12">
                <div
                    class="animate-spin w-12 h-12 border-4 border-brand-200 border-t-brand-600 rounded-full mx-auto mb-4">
                </div>
                <p class="text-gray-500">Cargando productos...</p>
            </div>

            <!-- Products Grid -->
            <div id="catalogGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
                <!-- Products will be loaded here via JavaScript -->
            </div>

            <!-- No Products State -->
            <div id="noProducts" class="hidden text-center py-12">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-box-open text-gray-400 text-2xl"></i>
                </div>
                <p class="text-gray-500">No se encontraron productos</p>
            </div>

            <!-- Last Update -->
            <div class="text-center mt-8 text-sm text-gray-400">
                <span id="lastUpdate"></span>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-brand-600">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold text-white mb-4">¿Listo para comprar?</h2>
            <p class="text-brand-100 mb-8">Regístrate ahora y accede a ofertas exclusivas</p>
            <% if (typeof user==='undefined' || !user) { %>
                <a href="/auth/register"
                    class="inline-block bg-white text-brand-600 px-8 py-4 rounded-full font-bold text-lg hover:bg-gray-100 transition-all shadow-xl">
                    Crear Mi Cuenta
                </a>
                <% } %>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center text-white">
                        <i class="fas fa-shopping-basket"></i>
                    </div>
                    <span class="font-bold text-xl tracking-tight text-gray-900">MAXMARKET</span>
                </div>
                <p class="text-gray-500 text-sm">© <%= new Date().getFullYear() %> MaxMarket. Todos los derechos
                        reservados.</p>
                <div class="flex gap-4">
                    <a href="#" class="text-gray-400 hover:text-brand-600 transition-colors"><i
                            class="fab fa-facebook text-xl"></i></a>
                    <a href="#" class="text-gray-400 hover:text-brand-600 transition-colors"><i
                            class="fab fa-instagram text-xl"></i></a>
                    <a href="#" class="text-gray-400 hover:text-brand-600 transition-colors"><i
                            class="fab fa-twitter text-xl"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // HU-08: Public Catalog JavaScript
        let debounceTimer;

        // Load categories on page load
        async function loadCategories() {
            try {
                const res = await fetch('/api/public/categories');
                const data = await res.json();
                if (data.success) {
                    const select = document.getElementById('categoryFilter');
                    data.categories.forEach(cat => {
                        const option = document.createElement('option');
                        option.value = cat;
                        option.textContent = cat;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Error loading categories:', error);
            }
        }

        // Load products from public API
        async function loadPublicProducts() {
            const loading = document.getElementById('catalogLoading');
            const grid = document.getElementById('catalogGrid');
            const noProducts = document.getElementById('noProducts');
            const lastUpdate = document.getElementById('lastUpdate');

            const search = document.getElementById('catalogSearch').value;
            const category = document.getElementById('categoryFilter').value;

            loading.classList.remove('hidden');
            grid.innerHTML = '';
            noProducts.classList.add('hidden');

            try {
                const params = new URLSearchParams();
                if (search) params.append('search', search);
                if (category) params.append('category', category);
                params.append('limit', '20');

                const res = await fetch(`/api/public/products?${params}`);
                const data = await res.json();

                loading.classList.add('hidden');

                if (data.success && data.products.length > 0) {
                    data.products.forEach(product => {
                        grid.appendChild(createProductCard(product));
                    });
                    lastUpdate.textContent = `Última actualización: ${new Date(data.timestamp).toLocaleTimeString('es-CL')}`;
                } else {
                    noProducts.classList.remove('hidden');
                    lastUpdate.textContent = '';
                }
            } catch (error) {
                console.error('Error loading products:', error);
                loading.classList.add('hidden');
                noProducts.classList.remove('hidden');
            }
        }

        // Create product card HTML
        function createProductCard(product) {
            const card = document.createElement('div');
            card.className = 'bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group hover:shadow-lg transition-all';

            const statusColors = {
                'available': 'bg-green-500',
                'low_stock': 'bg-orange-500',
                'out_of_stock': 'bg-red-500'
            };

            const statusBgColors = {
                'available': 'bg-green-50 text-green-700',
                'low_stock': 'bg-orange-50 text-orange-700',
                'out_of_stock': 'bg-red-50 text-red-700'
            };

            card.innerHTML = `
                <div class="relative pt-[100%] bg-gray-100">
                    <img src="${product.image || '/img/no-image.png'}" 
                         alt="${product.name}"
                         class="absolute top-0 left-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                         onerror="this.src='/img/no-image.png'">
                    <div class="absolute top-2 right-2">
                        <span class="w-3 h-3 rounded-full ${statusColors[product.status]} inline-block shadow"></span>
                    </div>
                    ${product.status === 'out_of_stock' ? '<div class="absolute inset-0 bg-gray-900/30 flex items-center justify-center"><span class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold">AGOTADO</span></div>' : ''}
                </div>
                <div class="p-4">
                    <span class="text-xs text-gray-400 uppercase tracking-wide">${product.category || 'General'}</span>
                    <h3 class="font-bold text-gray-900 truncate mt-1">${product.name}</h3>
                    <div class="flex items-center justify-between mt-2">
                        <p class="text-brand-600 font-bold text-lg">Bs. ${parseFloat(product.price).toFixed(2)}</p>
                        <span class="text-xs px-2 py-1 rounded-full ${statusBgColors[product.status]}">${product.statusLabel}</span>
                    </div>
                    ${product.status !== 'out_of_stock' ? `<p class="text-xs text-gray-400 mt-1">${product.stock} unidades</p>` : ''}
                </div>
            `;

            return card;
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', () => {
            loadCategories();
            loadPublicProducts();
        });

        document.getElementById('catalogSearch').addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => loadPublicProducts(), 300);
        });

        document.getElementById('categoryFilter').addEventListener('change', () => {
            loadPublicProducts();
        });

        // Auto-refresh every 60 seconds
        setInterval(loadPublicProducts, 60000);
    </script>

    <style>
        @keyframes blob {
            0% {
                transform: translate(0px, 0px) scale(1);
            }

            33% {
                transform: translate(30px, -50px) scale(1.1);
            }

            66% {
                transform: translate(-20px, 20px) scale(0.9);
            }

            100% {
                transform: translate(0px, 0px) scale(1);
            }
        }

        .animate-blob {
            animation: blob 7s infinite;
        }

        .animation-delay-2000 {
            animation-delay: 2s;
        }

        .animation-delay-4000 {
            animation-delay: 4s;
        }
    </style>
</body>

</html>