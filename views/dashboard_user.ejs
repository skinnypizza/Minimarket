<%- include('partials/header') %>

<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- Mobile Viewport Meta -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<main class="min-h-screen py-3 px-2 sm:py-6 sm:px-4" style="background-color: #fafbf8;">
    <div class="max-w-7xl mx-auto">
        
        <!-- Welcome Header -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-3 sm:p-6 mb-3 sm:mb-6" style="border-top: 4px solid #52b788;">
            <div class="flex items-center justify-between flex-wrap gap-2 sm:gap-4">
                <div>
                    <h1 class="text-xl sm:text-3xl font-bold mb-1 sm:mb-2" style="color: #2d3436;">
                        ¡Hola, <%= user.name %>! 🛒
                    </h1>
                    <p class="text-xs sm:text-base" style="color: #636e72;">
                        <i class="fas fa-envelope mr-1 sm:mr-2"></i><%= user.email %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Main Layout -->
        <div class="flex flex-col lg:flex-row gap-3 sm:gap-6">
            
            <!-- Cart Section - ARRIBA en móvil, DERECHA en desktop -->
            <div class="w-full lg:w-80 lg:flex-shrink-0 lg:order-2">
                <%- include('partials/user_cart') %>
            </div>

            <!-- Products Section - ABAJO en móvil, IZQUIERDA en desktop -->
            <div class="w-full lg:flex-1 lg:order-1">
                <%- include('partials/user_product_catalog') %>
            </div>
        </div>

        <!-- Reservations History Section -->
        <div class="mt-3 sm:mt-6">
            <%- include('partials/user_reservations') %>
        </div>

    </div>
</main>

<!-- Notification Toast -->
<div id="notificationToast" class="fixed bottom-6 left-6 z-50 hidden" style="max-width: 350px;">
    <div class="bg-white rounded-lg shadow-2xl p-4 transform transition-all">
        <div class="flex items-center gap-3">
            <div id="notificationIcon" class="text-2xl"></div>
            <div class="flex-1">
                <div id="notificationMessage" class="font-semibold" style="color: #2d3436;"></div>
            </div>
            <button onclick="hideNotification()" style="color: #636e72;" onmouseover="this.style.color='#2d3436'" onmouseout="this.style.color='#636e72'">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
</div>

<script>
// ========================================
// CART FUNCTIONALITY
// ========================================

let cart = [];
let viewMode = 'grid';

// Initialize cart from server
async function initCart() {
    try {
        const response = await fetch('/cart/my-cart');
        const data = await response.json();
        
        if (data.success && data.cart && data.cart.items) {
            cart = data.cart.items.map(item => ({
                productId: item.productId,
                name: item.product.name,
                price: item.unitPrice,
                quantity: item.quantity,
                maxStock: item.product.totalStock || 0
            }));
            updateCartDisplay();
        }
    } catch (err) {
        console.error('Error loading cart:', err);
    }
}

// Add product to cart
function addToCart(productId, productName, productPrice, maxStock) {
    const existingItem = cart.find(item => item.productId == productId);
    
    if (existingItem) {
        if (existingItem.quantity < maxStock) {
            existingItem.quantity += 1;
            showNotification(`Se agregó otra unidad de ${productName}`, 'success');
        } else {
            showNotification(`Stock máximo alcanzado para ${productName}`, 'warning');
            return;
        }
    } else {
        cart.push({
            productId: productId,
            name: productName,
            price: parseFloat(productPrice),
            quantity: 1,
            maxStock: maxStock
        });
        showNotification(`${productName} agregado al carrito`, 'success');
    }
    
    updateCartDisplay();
}

// Remove item from cart
function removeFromCart(productId) {
    cart = cart.filter(item => item.productId != productId);
    updateCartDisplay();
    showNotification('Producto eliminado del carrito', 'info');
}

// Update quantity
function updateQuantity(productId, newQuantity) {
    const item = cart.find(item => item.productId == productId);
    
    if (item) {
        if (newQuantity <= 0) {
            removeFromCart(productId);
        } else if (newQuantity <= item.maxStock) {
            item.quantity = newQuantity;
            updateCartDisplay();
        } else {
            showNotification('Cantidad excede el stock disponible', 'warning');
        }
    }
}

// Update cart display
function updateCartDisplay() {
    const cartItemsContainer = document.getElementById('cartItems');
    const cartCount = document.getElementById('cartCount');
    const cartSummary = document.getElementById('cartSummary');
    const emptyMessage = document.getElementById('emptyCartMessage');
    const subtotalAmount = document.getElementById('subtotalAmount');
    const totalAmount = document.getElementById('totalAmount');
    
    // Verificar que los elementos existen
    if (!cartItemsContainer || !cartCount || !cartSummary || !emptyMessage || !subtotalAmount || !totalAmount) {
        console.error('Elementos del carrito no encontrados en el DOM');
        return;
    }
    
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    cartCount.textContent = totalItems;
    
    if (cart.length === 0) {
        emptyMessage.style.display = 'block';
        cartSummary.style.display = 'none';
        cartItemsContainer.innerHTML = '';
    } else {
        emptyMessage.style.display = 'none';
        cartSummary.style.display = 'block';
        
        cartItemsContainer.innerHTML = cart.map(item => `
            <div class="p-2 sm:p-3 transition-colors" style="border-bottom: 1px solid #e8f5f0;"
                 ontouchstart="this.style.backgroundColor='#fafbf8'"
                 ontouchend="this.style.backgroundColor='white'"
                 onmouseover="this.style.backgroundColor='#fafbf8'"
                 onmouseout="this.style.backgroundColor='white'">
                <div class="flex justify-between items-start mb-1.5 sm:mb-2">
                    <div class="flex-1 pr-2">
                        <div class="font-semibold text-xs sm:text-sm" style="color: #2d3436;">${item.name}</div>
                        <div class="font-bold" style="color: #52b788; font-size: 0.65rem;">Bs. ${item.price.toFixed(2)}</div>
                    </div>
                    <button onclick="removeFromCart('${item.productId}')" 
                            class="transition-colors p-1.5 active:scale-95"
                            style="color: #d63031;"
                            ontouchstart="this.style.color='#c0392b'"
                            ontouchend="this.style.color='#d63031'"
                            onmouseover="this.style.color='#c0392b'"
                            onmouseout="this.style.color='#d63031'">
                        <i class="fas fa-trash-alt text-xs"></i>
                    </button>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1">
                        <button onclick="updateQuantity('${item.productId}', ${item.quantity - 1})" 
                                class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center font-bold text-xs sm:text-sm transition-colors active:scale-95"
                                style="background-color: #e8f5f0; color: #52b788;"
                                ontouchstart="this.style.backgroundColor='#b8e6d5'"
                                ontouchend="this.style.backgroundColor='#e8f5f0'"
                                onmouseover="this.style.backgroundColor='#b8e6d5'"
                                onmouseout="this.style.backgroundColor='#e8f5f0'">
                            -
                        </button>
                        <input type="number" 
                               value="${item.quantity}" 
                               min="1" 
                               max="${item.maxStock}"
                               onchange="updateQuantity('${item.productId}', parseInt(this.value) || 1)"
                               class="w-10 sm:w-12 text-center rounded py-1 font-semibold"
                               style="border: 1px solid #d4d8d4; font-size: 0.7rem;">
                        <button onclick="updateQuantity('${item.productId}', ${item.quantity + 1})" 
                                class="w-6 h-6 sm:w-7 sm:h-7 rounded flex items-center justify-center font-bold text-xs sm:text-sm transition-colors active:scale-95"
                                style="background-color: #e8f5f0; color: #52b788;"
                                ontouchstart="this.style.backgroundColor='#b8e6d5'"
                                ontouchend="this.style.backgroundColor='#e8f5f0'"
                                onmouseover="this.style.backgroundColor='#b8e6d5'"
                                onmouseout="this.style.backgroundColor='#e8f5f0'">
                            +
                        </button>
                    </div>
                    <div class="font-bold text-xs sm:text-sm" style="color: #2d3436;">
                        ${(item.price * item.quantity).toFixed(2)}
                    </div>
                </div>
                <div class="text-xs mt-0.5 sm:mt-1" style="color: #636e72; font-size: 0.65rem;">
                    Stock: ${item.maxStock}
                </div>
            </div>
        `).join('');
        
        subtotalAmount.textContent = total.toFixed(2);
        totalAmount.textContent = total.toFixed(2);
    }
}

// Save reservation
async function saveReservation() {
    if (cart.length === 0) {
        showNotification('El carrito está vacío', 'warning');
        return;
    }

    const saveBtn = document.getElementById('saveReservationBtn');
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';

    try {
        const items = cart.map(item => ({
            productId: item.productId,
            quantity: item.quantity
        }));

        const response = await fetch('/cart/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
        });

        const data = await response.json();

        if (data.success) {
            showNotification(`¡Reserva guardada! Número: ${data.cart.reservationNumber}`, 'success');
            // VACIAR EL CARRITO después de guardar reserva
            cart = [];
            updateCartDisplay();
            loadReservations();
        } else {
            showNotification(data.message || 'Error al guardar la reserva', 'error');
        }
    } catch (err) {
        console.error('Error saving reservation:', err);
        showNotification('Error al conectar con el servidor', 'error');
    } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-bookmark"></i> Guardar Reserva';
    }
}

// Clear cart
function clearCart() {
    if (cart.length === 0) return;
    
    if (confirm('¿Estás seguro de que quieres limpiar el carrito?')) {
        cart = [];
        updateCartDisplay();
        showNotification('Carrito limpiado', 'info');
    }
}

// ========================================
// PRODUCT SEARCH & FILTER
// ========================================

let selectedCategory = 'all';

function filterProducts() {
    const searchInput = document.getElementById('searchInput').value.toLowerCase();
    const productCards = document.querySelectorAll('.product-card');
    
    productCards.forEach(card => {
        const productName = card.dataset.productName.toLowerCase();
        const productCategory = card.dataset.productCategory;
        
        const matchesSearch = productName.includes(searchInput);
        const matchesCategory = selectedCategory === 'all' || productCategory === selectedCategory;
        
        card.style.display = (matchesSearch && matchesCategory) ? 'block' : 'none';
    });
}

function filterByCategory(category) {
    selectedCategory = category;
    
    // Update button styles
    document.querySelectorAll('[id^="cat-"]').forEach(btn => {
        if (btn.id === 'cat-' + category) {
            btn.style.backgroundColor = '#52b788';
            btn.style.color = 'white';
        } else {
            btn.style.backgroundColor = '#e8f5f0';
            btn.style.color = '#52b788';
        }
    });
    
    filterProducts();
}

// View mode toggle (not used in mobile-first design but kept for compatibility)
function setViewMode(mode) {
    viewMode = mode;
    // Grid mode is default and responsive, no need to toggle on mobile
}

// ========================================
// NOTIFICATIONS
// ========================================

function showNotification(message, type = 'info') {
    const toast = document.getElementById('notificationToast');
    const icon = document.getElementById('notificationIcon');
    const messageEl = document.getElementById('notificationMessage');
    
    const icons = {
        success: '✅',
        error: '❌',
        warning: '⚠️',
        info: 'ℹ️'
    };
    
    icon.textContent = icons[type] || icons.info;
    messageEl.textContent = message;
    
    toast.classList.remove('hidden');
    toast.classList.add('animate-slide-in');
    
    setTimeout(() => {
        hideNotification();
    }, 4000);
}

function hideNotification() {
    const toast = document.getElementById('notificationToast');
    toast.classList.add('hidden');
    toast.classList.remove('animate-slide-in');
}

// ========================================
// INITIALIZATION
// ========================================

document.addEventListener('DOMContentLoaded', function() {
    // Load cart from server
    initCart();
    
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', filterProducts);
    }
});
</script>

<style>
@keyframes slide-in {
    from {
        transform: translateX(-100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.animate-slide-in {
    animation: slide-in 0.3s ease-out;
}

/* Custom scrollbar */
#cartItemsContainer::-webkit-scrollbar {
    width: 6px;
}

#cartItemsContainer::-webkit-scrollbar-track {
    background: #f1f1f1;
}

#cartItemsContainer::-webkit-scrollbar-thumb {
    background: #52b788;
    border-radius: 3px;
}

#cartItemsContainer::-webkit-scrollbar-thumb:hover {
    background: #40916c;
}

/* Mobile optimizations */
@media (max-width: 640px) {
    /* Prevent zoom on input focus */
    input[type="number"],
    input[type="text"],
    input[type="search"] {
        font-size: 16px !important;
    }
    
    /* Smooth scrolling on mobile */
    * {
        -webkit-overflow-scrolling: touch;
    }
    
    /* Better tap targets */
    button {
        min-height: 44px;
        min-width: 44px;
    }
}

/* Desktop and tablet */
@media (min-width: 1024px) {
    #cartItemsContainer {
        max-height: 500px !important;
        overflow-y: auto !important;
    }
}
</style>

<%- include('partials/footer') %>
