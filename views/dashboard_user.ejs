<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Minimarket - Tu Tienda Favorita</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f3f4f6;
        }

        .glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .bottom-nav-item.active {
            color: #16a34a;
        }

        .product-card {
            transition: transform 0.2s;
        }

        .product-card:active {
            transform: scale(0.98);
        }
    </style>
</head>

<body class="pb-20 md:pb-0">

    <!-- Desktop Header -->
    <header class="hidden md:block bg-brand-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fas fa-store text-2xl"></i>
                <h1 class="text-2xl font-bold tracking-tight">Minimarket</h1>
            </div>
            <div class="flex items-center gap-6">
                <span class="text-brand-100">Hola, <%= user.name %></span>
                <button onclick="toggleCart()" class="relative p-2 hover:bg-brand-700 rounded-full transition">
                    <i class="fas fa-shopping-cart text-xl"></i>
                    <span id="desktopCartCount"
                        class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center hidden">0</span>
                </button>
                <a href="/auth/logout" class="hover:text-brand-200 transition"><i class="fas fa-sign-out-alt"></i>
                    Salir</a>
            </div>
        </div>
    </header>

    <!-- Mobile Header -->
    <header
        class="md:hidden bg-white/90 backdrop-blur-md sticky top-0 z-40 border-b border-gray-200 px-4 py-3 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold text-gray-800">Minimarket</h1>
            <p class="text-xs text-gray-500">Hola, <%= user.name %>
            </p>
        </div>
        <button onclick="toggleCart()" class="relative p-2 text-gray-700">
            <i class="fas fa-shopping-cart text-xl"></i>
            <span id="mobileCartCount"
                class="absolute top-0 right-0 bg-brand-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden">0</span>
        </button>
    </header>

    <main class="max-w-7xl mx-auto p-4 md:p-6 flex gap-6">

        <!-- Product Section -->
        <div class="flex-1">
            <!-- Search & Filter -->
            <div class="mb-6 space-y-4">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="searchInput" placeholder="Buscar productos..."
                        class="w-full pl-10 pr-4 py-3 rounded-xl border-none shadow-sm bg-white focus:ring-2 focus:ring-brand-500 transition-all text-gray-700 placeholder-gray-400">
                </div>

                <!-- Categories -->
                <div class="flex gap-2 overflow-x-auto hide-scrollbar pb-2">
                    <button onclick="filterByCategory('all')" id="cat-all"
                        class="category-btn active px-4 py-2 rounded-full bg-brand-600 text-white text-sm font-medium whitespace-nowrap shadow-sm transition-colors">Todos</button>
                    <% const categories=[...new Set(products.map(p=> p.category || 'General'))]; %>
                        <% categories.forEach(cat=> { %>
                            <button onclick="filterByCategory('<%= cat %>')" id="cat-<%= cat %>"
                                class="category-btn px-4 py-2 rounded-full bg-white text-gray-600 text-sm font-medium whitespace-nowrap shadow-sm border border-gray-100 hover:bg-gray-50 transition-colors">
                                <%= cat %>
                            </button>
                            <% }); %>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-6 pb-20 md:pb-0">
                <% products.forEach(product=> { %>
                    <div class="product-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col h-full"
                        data-product-name="<%= product.name %>"
                        data-product-category="<%= product.category || 'General' %>">
                        <div class="relative pt-[75%] bg-gray-100">
                            <img src="<%= product.image || '/img/no-image.png' %>" alt="<%= product.name %>"
                                class="absolute top-0 left-0 w-full h-full object-cover">
                            <% if (product.totalStock <=5 && product.totalStock> 0) { %>
                                <span
                                    class="absolute top-2 right-2 bg-orange-500 text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-sm">¡Pocos!</span>
                                <% } else if (product.totalStock===0) { %>
                                    <div
                                        class="absolute inset-0 bg-white/60 backdrop-blur-[2px] flex items-center justify-center">
                                        <span
                                            class="bg-gray-800 text-white text-xs font-bold px-3 py-1 rounded-full">Agotado</span>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="p-3 md:p-4 flex-1 flex flex-col">
                            <h3 class="font-semibold text-gray-800 text-sm md:text-base mb-1 line-clamp-2">
                                <%= product.name %>
                            </h3>
                            <p class="text-xs text-gray-500 mb-2 line-clamp-2">
                                <%= product.description %>
                            </p>
                            <div class="mt-auto flex items-center justify-between">
                                <span class="text-brand-600 font-bold text-base md:text-lg">Bs. <%=
                                        parseFloat(product.price).toFixed(2) %></span>
                                <button
                                    onclick="addToCart('<%= product.id %>', '<%= product.name %>', <%= product.price %>, <%= product.totalStock %>)"
                                    class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center hover:bg-brand-600 hover:text-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    <%=product.totalStock===0 ? 'disabled' : '' %>>
                                    <i class="fas fa-plus text-xs md:text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>

        <!-- Desktop Sidebar Cart -->
        <div class="hidden lg:block w-96 flex-shrink-0">
            <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24 border border-gray-100">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-gray-800">Tu Carrito</h2>
                    <span class="bg-brand-100 text-brand-700 text-xs font-bold px-2 py-1 rounded-full"><span
                            id="sidebarCartCount">0</span> items</span>
                </div>

                <div id="sidebarCartItems"
                    class="space-y-4 max-h-[calc(100vh-350px)] overflow-y-auto pr-2 custom-scrollbar">
                    <!-- Cart items injected here -->
                    <div class="text-center py-10 text-gray-400">
                        <i class="fas fa-shopping-basket text-4xl mb-3 opacity-50"></i>
                        <p>Tu carrito está vacío</p>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t border-gray-100">
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-gray-600">Total</span>
                        <span class="text-2xl font-bold text-brand-600">Bs. <span id="sidebarTotal">0.00</span></span>
                    </div>
                    <button onclick="saveReservation()" id="sidebarCheckoutBtn"
                        class="w-full py-3 bg-brand-600 text-white rounded-xl font-semibold shadow-lg shadow-brand-200 hover:bg-brand-700 transition-transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                        Confirmar Reserva
                    </button>
                </div>
            </div>
        </div>

    </main>

    <!-- Mobile Bottom Navigation -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 pb-safe z-40">
        <div class="grid grid-cols-4 h-16">
            <button onclick="switchTab('home')"
                class="bottom-nav-item active flex flex-col items-center justify-center text-gray-400 hover:text-brand-600 transition-colors">
                <i class="fas fa-home text-xl mb-1"></i>
                <span class="text-[10px] font-medium">Inicio</span>
            </button>
            <button onclick="switchTab('history')"
                class="bottom-nav-item flex flex-col items-center justify-center text-gray-400 hover:text-brand-600 transition-colors">
                <i class="fas fa-history text-xl mb-1"></i>
                <span class="text-[10px] font-medium">Historial</span>
            </button>
            <button onclick="toggleCart()"
                class="bottom-nav-item flex flex-col items-center justify-center text-gray-400 hover:text-brand-600 transition-colors relative">
                <div class="relative">
                    <i class="fas fa-shopping-bag text-xl mb-1"></i>
                    <span id="navCartBadge"
                        class="absolute -top-1 -right-2 bg-brand-500 text-white text-[9px] font-bold w-3.5 h-3.5 rounded-full flex items-center justify-center hidden">0</span>
                </div>
                <span class="text-[10px] font-medium">Carrito</span>
            </button>
            <a href="/auth/logout"
                class="bottom-nav-item flex flex-col items-center justify-center text-gray-400 hover:text-red-500 transition-colors">
                <i class="fas fa-user text-xl mb-1"></i>
                <span class="text-[10px] font-medium">Perfil</span>
            </a>
        </div>
    </nav>

    <!-- Mobile Cart Drawer / Modal -->
    <div id="cartDrawer"
        class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="toggleCart()"></div>
        <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl flex flex-col">
            <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-white z-10">
                <h2 class="text-lg font-bold text-gray-800">Mi Carrito</h2>
                <button onclick="toggleCart()"
                    class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-gray-200">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div id="drawerCartItems" class="flex-1 overflow-y-auto p-4 space-y-4">
                <!-- Cart items injected here -->
            </div>

            <div class="p-4 border-t border-gray-100 bg-gray-50 pb-safe">
                <div class="flex justify-between items-center mb-4">
                    <span class="text-gray-600 font-medium">Total a Pagar</span>
                    <span class="text-2xl font-bold text-brand-600">Bs. <span id="drawerTotal">0.00</span></span>
                </div>
                <button onclick="saveReservation()" id="drawerCheckoutBtn"
                    class="w-full py-3.5 bg-brand-600 text-white rounded-xl font-bold shadow-lg shadow-brand-200 active:scale-95 transition-all disabled:opacity-50">
                    Confirmar Reserva
                </button>
            </div>
        </div>
    </div>

    <!-- History Modal (Mobile) / Section (Desktop) -->
    <div id="historyView"
        class="fixed inset-0 z-50 bg-white transform translate-y-full transition-transform duration-300 md:hidden flex flex-col">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-white sticky top-0 z-10">
            <h2 class="text-lg font-bold text-gray-800">Historial de Reservas</h2>
            <button onclick="switchTab('home')" class="text-gray-500">
                <i class="fas fa-chevron-down text-xl"></i>
            </button>
        </div>
        <div id="mobileReservationsList" class="flex-1 overflow-y-auto p-4 bg-gray-50">
            <!-- Reservations injected here -->
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast"
        class="fixed top-4 left-1/2 -translate-x-1/2 z-[60] transform -translate-y-20 transition-transform duration-300 bg-white px-6 py-3 rounded-full shadow-xl border border-gray-100 flex items-center gap-3 min-w-[300px]">
        <div id="toastIcon" class="text-xl"></div>
        <p id="toastMessage" class="text-sm font-medium text-gray-700 flex-1"></p>
    </div>

    <script src="/js/user-dashboard.js"></script>
</body>

</html>