<!DOCTYPE html>
<html lang="es">

<head>
    <title>Editar Producto - MAXMARKET</title>
    <%- include('partials/head_tailwind') %>
</head>

<body class="bg-gray-50 font-sans text-gray-900">
    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="bg-white shadow-sm sticky top-0 z-10">
            <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="/dashboard"
                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-600 hover:bg-gray-100 transition-colors">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <h1 class="text-xl font-bold text-gray-900">Editar Producto</h1>
                </div>
            </div>
        </header>

        <main class="flex-1 max-w-3xl mx-auto w-full px-4 py-6 space-y-6">

            <!-- Flash Messages -->
            <% if (locals.messages && messages.length> 0) { %>
                <div class="space-y-2">
                    <% messages.forEach(function(message) { %>
                        <div
                            class="p-4 rounded-xl border <%= message.type === 'error' ? 'bg-red-50 border-red-100 text-red-600' : 'bg-green-50 border-green-100 text-green-600' %> flex items-start gap-3">
                            <i
                                class="<%= message.type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle' %> mt-0.5"></i>
                            <p class="text-sm font-medium">
                                <%= message.text %>
                            </p>
                        </div>
                        <% }); %>
                </div>
                <% } %>

                    <!-- Edit Form -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="p-6 border-b border-gray-100">
                            <h2 class="text-lg font-bold text-gray-800">Información del Producto</h2>
                            <p class="text-sm text-gray-500">Actualiza los detalles básicos del producto</p>
                        </div>

                        <form action="/products/<%= product.id %>/update" method="POST" enctype="multipart/form-data"
                            class="p-6 space-y-6">

                            <!-- Image Preview & Upload -->
                            <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
                                <div class="relative group">
                                    <% if (product.image) { %>
                                        <img src="<%= product.image %>" alt="Current image"
                                            class="w-24 h-24 rounded-xl object-cover border-2 border-gray-100">
                                        <% } else { %>
                                            <div
                                                class="w-24 h-24 rounded-xl bg-gray-100 flex items-center justify-center border-2 border-gray-200 text-gray-400">
                                                <i class="fas fa-image text-3xl"></i>
                                            </div>
                                            <% } %>
                                                <div class="absolute inset-0 bg-black/50 rounded-xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
                                                    onclick="document.getElementById('image').click()">
                                                    <i class="fas fa-camera text-white"></i>
                                                </div>
                                </div>
                                <div class="flex-1 w-full">
                                    <label class="block text-sm font-bold text-gray-700 mb-2">Imagen del
                                        Producto</label>
                                    <input id="image" name="image" type="file" accept="image/*"
                                        class="w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 transition-all cursor-pointer" />
                                    <p class="text-xs text-gray-400 mt-1">JPG, PNG o GIF. Máx 5MB.</p>
                                </div>
                            </div>

                            <!-- Fields -->
                            <div class="space-y-4">
                                <div>
                                    <label for="name" class="block text-sm font-bold text-gray-700 mb-2">Nombre</label>
                                    <input id="name" name="name" required value="<%= product.name %>"
                                        class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all font-medium" />
                                </div>

                                <div>
                                    <label for="description"
                                        class="block text-sm font-bold text-gray-700 mb-2">Descripción</label>
                                    <textarea id="description" name="description" rows="3"
                                        class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all resize-none"><%= product.description %></textarea>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label for="price" class="block text-sm font-bold text-gray-700 mb-2">Precio
                                            (Bs.)</label>
                                        <div class="relative">
                                            <span
                                                class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold">Bs.</span>
                                            <input id="price" name="price" type="number" step="0.01"
                                                value="<%= product.price %>" required
                                                class="w-full pl-12 pr-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all font-bold text-gray-800" />
                                        </div>
                                    </div>
                                    <div>
                                        <label for="category"
                                            class="block text-sm font-bold text-gray-700 mb-2">Categoría</label>
                                        <select id="category" name="category" required
                                            class="w-full px-4 py-3 rounded-xl bg-gray-50 border-none focus:bg-white focus:ring-2 focus:ring-brand-500 shadow-sm outline-none transition-all appearance-none cursor-pointer">
                                            <% const categories=['Lácteos', 'Panadería' , 'Despensa' , 'Bebidas'
                                                , 'Snacks' , 'Limpieza' , 'Enlatados' , 'Congelados' , 'General' ]; %>
                                                <% categories.forEach(cat=> { %>
                                                    <option value="<%= cat %>" <%=product.category===cat ? 'selected'
                                                        : '' %>><%= cat %>
                                                    </option>
                                                    <% }); %>
                                        </select>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-bold text-gray-700 mb-2">Stock Total</label>
                                    <div
                                        class="flex items-center justify-between px-4 py-3 rounded-xl bg-gray-100 border border-gray-200">
                                        <span class="font-bold text-gray-800 text-lg">
                                            <%= product.stock %> unidades
                                        </span>
                                        <span
                                            class="text-xs font-medium text-gray-500 bg-white px-2 py-1 rounded-lg border border-gray-200">Calculado
                                            autom.</span>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-2 ml-1">El stock se gestiona a través de los
                                        lotes.</p>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="pt-4 flex items-center gap-3">
                                <button type="submit"
                                    class="flex-1 py-3.5 bg-brand-600 text-white rounded-xl font-bold shadow-lg shadow-brand-200 hover:bg-brand-700 transform hover:-translate-y-0.5 transition-all">
                                    Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Batch Management -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
                            <div>
                                <h2 class="text-lg font-bold text-gray-800">Gestión de Lotes</h2>
                                <p class="text-sm text-gray-500">Historial de ingresos</p>
                            </div>
                            <span class="bg-brand-50 text-brand-700 px-3 py-1 rounded-full text-xs font-bold">
                                <%= product.batches ? product.batches.length : 0 %> Lotes
                            </span>
                        </div>

                        <!-- Add Batch Form -->
                        <div class="p-6 bg-gray-50 border-b border-gray-100">
                            <form action="/products/<%= product.id %>/batch" method="POST"
                                class="flex flex-col sm:flex-row gap-4 items-end">
                                <div class="flex-1 w-full">
                                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Cantidad</label>
                                    <input type="number" name="quantity" required min="1" placeholder="Ej: 50"
                                        class="w-full px-4 py-2.5 rounded-xl bg-white border border-gray-200 focus:ring-2 focus:ring-brand-500 outline-none transition-all" />
                                </div>
                                <div class="flex-1 w-full">
                                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Costo Unitario
                                        (Bs.)</label>
                                    <input type="number" name="purchasePrice" required step="0.01" min="0"
                                        placeholder="Ej: 8.50"
                                        class="w-full px-4 py-2.5 rounded-xl bg-white border border-gray-200 focus:ring-2 focus:ring-brand-500 outline-none transition-all" />
                                </div>
                                <button type="submit"
                                    class="w-full sm:w-auto px-6 py-2.5 bg-gray-900 text-white rounded-xl font-bold hover:bg-gray-800 transition-colors flex items-center justify-center gap-2">
                                    <i class="fas fa-plus text-xs"></i> Agregar
                                </button>
                            </form>
                        </div>

                        <!-- Batches List -->
                        <div class="divide-y divide-gray-100">
                            <% if (product.batches && product.batches.length> 0) { %>
                                <% product.batches.forEach(batch=> { %>
                                    <div
                                        class="p-4 flex items-center justify-between hover:bg-gray-50 transition-colors">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
                                                #<%= batch.id %>
                                            </div>
                                            <div>
                                                <p class="font-bold text-gray-800">
                                                    <%= batch.quantity %> unidades
                                                </p>
                                                <p class="text-xs text-gray-500">
                                                    <%= new Date(batch.purchaseDate).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <p class="font-bold text-gray-900">Bs. <%= batch.purchasePrice %>
                                            </p>
                                            <p class="text-xs text-gray-400">Costo unitario</p>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="p-8 text-center">
                                                <div
                                                    class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-400">
                                                    <i class="fas fa-boxes"></i>
                                                </div>
                                                <p class="text-gray-500 font-medium">No hay lotes registrados</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Danger Zone -->
                    <div class="p-6 rounded-2xl border border-red-100 bg-red-50">
                        <h3 class="text-red-800 font-bold mb-2">Zona de Peligro</h3>
                        <p class="text-sm text-red-600 mb-4">Eliminar este producto borrará permanentemente todos sus
                            datos y lotes asociados.</p>
                        <form action="/products/<%= product.id %>/delete" method="POST"
                            onsubmit="return confirm('¿Estás seguro de eliminar este producto?');">
                            <button type="submit"
                                class="w-full py-3 bg-white border border-red-200 text-red-600 rounded-xl font-bold hover:bg-red-600 hover:text-white transition-all">
                                Eliminar Producto
                            </button>
                        </form>
                    </div>

        </main>
    </div>
</body>

</html>